              "code": { "type": "string", "pattern": "^BK[0-9]{4}$" },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "default": [],
          "description": "板块代码和名称，例如 BK0815 昨日涨停"
        },
        "stock-fund.aiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "AI API基础地址；API密钥单独存储在安全存储中"
        },
        "stock-fund.aiModel": {
          "type": "string",
          "default": "gpt-5.6",
          "description": "研报和股票分析使用的AI模型"
        },
        "stock-fund.aiApiMode": {
          "type": "string",
          "enum": [
            "responses",
            "chat-completions"
          ],
          "default": "responses",
          "description": "OpenAI使用Responses API，兼容网关可使用Chat Completions"
        },
        "stock-fund.aiStockHistoryRange": {
          "type": "string",
          "enum": [
            "1w",
            "1m",
            "3m",
            "6m",
            "1y"
          ],
          "default": "6m",
          "description": "AI股票分析包含的日K线历史范围"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"for(const path of ['dist','dist-integration'])require('fs').rmSync(path,{recursive:true,force:true})\"",
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js && esbuild src/webviewCharts.ts --bundle --platform=browser --target=chrome120 --format=iife --minify --outfile=dist/webviewCharts.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run src",
    "test:integration:compile": "tsc -p tsconfig.integration.json --pretty false",
    "test:integration": "pnpm --workspace-root build && pnpm test:integration:compile && node dist-integration/runTest.js",
    "package:vsix": "pnpm --workspace-root build && vsce package --no-dependencies --allow-missing-repository -o ../../stock-fund.vsix"
  },
  "dependencies": {
    "@stock-fund/data-sources": "workspace:*",
    "@stock-fund/domain": "workspace:*",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.25.5",
    "mocha": "10.8.2"
  }
}
