    "configuration": {
      "title": "股票基金",
      "properties": {
        "stock-fund.stocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "sh000001",
            "sh000300",
            "hk00700",
            "usr_ixic"
          ]
        },
        "stock-fund.stockGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "自定义股票分组名称；首次编辑分组时会迁移旧版自选股列表"
        },
        "stock-fund.stockLists": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": [],
          "description": "按自定义分组组织的股票代码"
        },
        "stock-fund.funds": {
          "type": "array",
          "default": [
            [
              "001632",
              "420009",
              "320007"
            ]
          ]
        },
        "stock-fund.fundGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "My Funds"
          ]
        },
        "stock-fund.interval": {
          "type": "number",
          "default": 5000,
          "minimum": 3000
        },
        "stock-fund.marketHoursEnabled": {
          "type": "boolean",
          "default": true,
          "description": "仅在对应市场交易时段自动刷新；首次和手动刷新始终执行"
        },
        "stock-fund.stockChartMode": {
          "type": "string",
          "enum": [
            "standard",
            "chips"
          ],
          "default": "standard",
          "description": "默认股票图表模式；沪深个股支持筹码分布"
        },
        "stock-fund.heldStockHighlightEnabled": {
          "type": "boolean",
          "default": true,
          "description": "在股票视图中高亮持仓股票并显示持仓标记"
