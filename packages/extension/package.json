          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tickerdock.addStock",
          "when": "view == tickerdock.stock && viewItem == stockGroup",
          "group": "inline"
        },
        {
          "command": "tickerdock.renameStockGroup",
          "when": "view == tickerdock.stock && viewItem == stockGroup",
          "group": "2_modify"
        },
        {
          "command": "tickerdock.removeStockGroup",
          "when": "view == tickerdock.stock && viewItem == stockGroup",
          "group": "3_remove"
        },
        {
          "command": "tickerdock.stockTop",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "inline"
        },
        {
          "command": "tickerdock.viewStockDetails",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "1_history"
        },
        {
          "command": "tickerdock.viewStockHistory",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "1_history"
        },
        {
          "command": "tickerdock.analyzeStock",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "1_history"
        },
        {
          "command": "tickerdock.viewStockResearch",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "1_history"
        },
        {
          "command": "tickerdock.addStockReminder",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "1_reminder"
        },
        {
          "command": "tickerdock.removeStockReminders",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
