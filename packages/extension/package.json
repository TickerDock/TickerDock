          "type": "string",
          "enum": [
            "original",
            "ascending",
            "descending"
          ],
          "default": "original",
          "description": "股票涨跌排序方式"
        },
        "stock-fund.fundSortMode": {
          "type": "string",
          "enum": [
            "original",
            "ascending",
            "descending",
            "amount-ascending",
            "amount-descending"
          ],
          "default": "original",
          "description": "基金涨跌或持仓市值排序方式"
        },
        "stock-fund.stockPrice": {
          "type": "object",
          "default": {},
