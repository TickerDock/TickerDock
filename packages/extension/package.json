        },
        "tickerdock.showStockPortfolioStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示股票持仓收益摘要"
        },
        "tickerdock.showFundPortfolioStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示基金持仓收益摘要"
        },
        "tickerdock.statusBarStocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "uniqueItems": true,
          "default": [
            "SH000001"
          ],
          "description": "在状态栏显示行情的自选股票"
        },
        "tickerdock.showMarketStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示所选行情"
        },
        "tickerdock.showStatusBarIcons": {
          "type": "boolean",
          "default": true,
          "description": "在行情状态栏中显示涨跌图标"
        },
        "tickerdock.stocksRemind": {
          "type": "object",
          "default": {},
          "description": "股票价格和涨跌幅提醒规则"
        },
        "tickerdock.remindersEnabled": {
          "type": "boolean",
          "default": true,
          "description": "启用股票阈值提醒"
        },
        "tickerdock.binance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "BTC_USDT",
            "ETH_USDT"
          ]
        },
        "tickerdock.binanceSortMode": {
          "type": "string",
          "enum": [
            "original",
            "ascending",
            "descending"
          ],
          "default": "original",
          "description": "币安24小时涨跌排序方式"
        },
        "tickerdock.binanceInterval": {
          "type": "number",
          "default": 10000,
          "minimum": 5000
        },
        "tickerdock.forexInterval": {
          "type": "number",
          "default": 3600000,
          "minimum": 300000
        },
        "tickerdock.newsInterval": {
          "type": "number",
          "default": 15000,
          "minimum": 10000
        },
        "tickerdock.newsSources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "jin10",
              "xuangubao"
            ]
          },
          "uniqueItems": true,
          "default": [
            "jin10",
            "xuangubao"
          ],
          "description": "合并快讯流包含的数据源"
        },
        "tickerdock.importantNewsOnly": {
          "type": "boolean",
          "default": false,
          "description": "合并快讯流中仅显示重要消息"
        },
        "tickerdock.flashNewsOutputEnabled": {
          "type": "boolean",
          "default": false,
          "description": "将新快讯写入输出频道并显示未读状态"
        },
        "tickerdock.flashNewsNotificationsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "每次刷新有重要快讯时最多显示一条通知"
        },
        "tickerdock.sectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "name"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^BK[0-9]{4}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "default": [],
          "description": "板块代码和名称，例如 BK0815 昨日涨停"
        },
        "tickerdock.aiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "AI API基础地址；API密钥单独存储在安全存储中"
        },
        "tickerdock.aiModel": {
          "type": "string",
          "default": "gpt-5.6",
          "description": "研报和股票分析使用的AI模型"
        },
        "tickerdock.aiApiMode": {
          "type": "string",
          "enum": [
            "responses",
            "chat-completions"
          ],
          "default": "responses",
          "description": "OpenAI使用Responses API，兼容网关可使用Chat Completions"
        },
        "tickerdock.aiStockHistoryRange": {
          "type": "string",
          "enum": [
            "1w",
            "1m",
            "3m",
            "6m",
            "1y"
          ],
          "default": "6m",
          "description": "AI股票分析包含的日K线历史范围"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"for(const path of ['dist','.build','dist-integration','tsconfig.tsbuildinfo','tsconfig.integration.tsbuildinfo'])require('fs').rmSync(path,{recursive:true,force:true})\"",
    "build": "pnpm --filter @tickerdock/webview-ui build && esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run tests",
    "coverage": "vitest run tests --coverage",
    "test:integration:compile": "tsc -p tsconfig.integration.json --pretty false",
    "test:integration": "pnpm --workspace-root build && pnpm test:integration:compile && node dist-integration/runTest.js",
    "package:vsix": "pnpm --workspace-root build && vsce package --no-dependencies -o ../../tickerdock.vsix"
  },
  "dependencies": {
    "@tickerdock/data-sources": "workspace:*",
    "@tickerdock/domain": "workspace:*",
    "echarts": "^6.1.0",
    "openai": "^6.48.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.25.5",
    "mocha": "10.8.2"
  }
}
