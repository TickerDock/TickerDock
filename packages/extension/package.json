          "type": "boolean",
          "default": true,
          "description": "在状态栏显示基金持仓收益摘要"
        },
        "stock-fund.statusBarStocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "uniqueItems": true,
          "default": [
            "sh000001"
          ],
          "description": "在状态栏显示行情的自选股票"
        },
        "stock-fund.showMarketStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示所选行情"
