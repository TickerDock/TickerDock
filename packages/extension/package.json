    "configuration": {
      "title": "TickerDock",
      "properties": {
        "tickerdock.stocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "SH000001",
            "SH000300",
            "HK00700",
            "0IXIC"
          ]
        },
        "tickerdock.stockGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "自定义股票分组名称；首次编辑分组时会迁移旧版自选股列表"
        },
        "tickerdock.stockLists": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": [],
          "description": "按自定义分组组织的股票代码"
        },
        "tickerdock.funds": {
          "type": "array",
          "default": [
            [
              "001632",
              "420009",
              "320007"
            ]
          ]
        },
        "tickerdock.fundGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "My Funds"
          ]
        },
        "tickerdock.interval": {
          "type": "number",
          "default": 5000,
          "minimum": 3000
        },
        "tickerdock.marketHoursEnabled": {
          "type": "boolean",
