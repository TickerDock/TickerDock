{
  "name": "stock-fund",
  "displayName": "Stock Fund",
  "description": "Stock and fund quotes powered by stock-api and fund-api",
  "version": "0.1.0",
  "publisher": "stock-fund-beta",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:stockFundView.stock",
    "onView:stockFundView.fund",
    "onView:stockFundView.binance",
    "onView:stockFundView.forex",
    "onView:stockFundView.news",
    "onView:stockFundView.sector",
    "onView:stockFundView.settings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stockFundMenu",
          "title": "Stock Fund",
          "icon": "resources/leekfund.svg"
        }
      ]
    },
    "views": {
      "stockFundMenu": [
        {
          "id": "stockFundView.stock",
          "name": "Stock"
        },
        {
          "id": "stockFundView.fund",
          "name": "Fund"
        },
        {
          "id": "stockFundView.binance",
          "name": "Binance"
        },
        {
          "id": "stockFundView.forex",
          "name": "Forex"
        },
        {
          "id": "stockFundView.news",
