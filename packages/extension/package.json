{
  "name": "tickerdock",
  "displayName": "TickerDock",
  "description": "在 VS Code 侧边栏快速查看股票、基金、期货、外汇和 Binance 行情并管理持仓",
  "version": "0.1.0",
  "publisher": "tickerdock",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TickerDock/TickerDock.git"
  },
  "homepage": "https://github.com/TickerDock/TickerDock#readme",
  "bugs": {
    "url": "https://github.com/TickerDock/TickerDock/issues"
  },
  "keywords": [
    "股票",
    "基金",
    "行情",
    "持仓",
    "stock",
    "fund",
    "ticker"
  ],
  "icon": "resources/tickerdock.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:tickerdock.stock",
    "onView:tickerdock.fund",
    "onView:tickerdock.binance",
    "onView:tickerdock.forex",
    "onView:tickerdock.news",
    "onView:tickerdock.sector",
    "onView:tickerdock.settings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tickerdock",
          "title": "TickerDock",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "tickerdock": [
        {
          "id": "tickerdock.stock",
          "name": "Stock"
        },
        {
          "id": "tickerdock.fund",
          "name": "Fund"
        },
        {
          "id": "tickerdock.binance",
          "name": "Binance"
        },
        {
          "id": "tickerdock.forex",
          "name": "Forex"
        },
        {
          "id": "tickerdock.news",
          "name": "Flash News"
        },
        {
          "id": "tickerdock.sector",
          "name": "板块"
        },
        {
          "id": "tickerdock.settings",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "tickerdock.refreshStock",
        "title": "刷新股票",
        "icon": "$(refresh)"
      },
      {
        "command": "tickerdock.refreshFund",
        "title": "刷新基金",
        "icon": "$(refresh)"
      },
      {
        "command": "tickerdock.sortStock",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "tickerdock.sortFund",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "tickerdock.sortFundAmount",
        "title": "按持仓市值排序基金",
        "icon": "$(symbol-number)"
      },
      {
        "command": "tickerdock.manageStockPositions",
        "title": "管理股票持仓",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "tickerdock.manageFundPositions",
        "title": "管理基金持仓",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "tickerdock.viewStockDetails",
        "title": "查看股票详情",
        "icon": "$(info)"
      },
      {
        "command": "tickerdock.viewStockHistory",
        "title": "查看股票走势",
        "icon": "$(graph)"
      },
      {
        "command": "tickerdock.toggleStockChartMode",
        "title": "切换标准/筹码图模式",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "tickerdock.toggleHeldStockHighlight",
        "title": "切换持仓股票高亮",
        "icon": "$(highlight)"
      },
      {
        "command": "tickerdock.toggleReminders",
        "title": "切换股票提醒",
        "icon": "$(bell)"
      },
      {
        "command": "tickerdock.viewStockResearch",
        "title": "查看股票研报",
        "icon": "$(book)"
      },
      {
        "command": "tickerdock.viewFundDetails",
        "title": "查看基金详情",
        "icon": "$(info)"
      },
      {
        "command": "tickerdock.viewFundHistory",
        "title": "查看基金走势",
        "icon": "$(graph)"
      },
      {
        "command": "tickerdock.viewFundHoldings",
        "title": "查看基金持仓",
        "icon": "$(pie-chart)"
      },
      {
        "command": "tickerdock.viewFundRanking",
        "title": "基金排行",
        "icon": "$(graph)"
      },
      {
        "command": "tickerdock.viewFundFlows",
        "title": "市场资金流向",
        "icon": "$(pulse)"
      },
      {
        "command": "tickerdock.viewFundComparison",
        "title": "对比基金表现",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "tickerdock.viewFundOverview",
        "title": "基金行情总览",
        "icon": "$(graph-line)"
      },
      {
        "command": "tickerdock.refreshBinance",
        "title": "刷新币安",
        "icon": "$(refresh)"
      },
      {
        "command": "tickerdock.addBinancePair",
        "title": "添加币安交易对",
        "icon": "$(add)"
      },
      {
        "command": "tickerdock.sortBinance",
        "title": "排序交易对",
        "icon": "$(list-ordered)"
      },
      {
        "command": "tickerdock.deleteBinancePair",
        "title": "移除交易对"
      },
      {
        "command": "tickerdock.binanceTop",
        "title": "交易对置顶"
      },
      {
        "command": "tickerdock.binanceUp",
        "title": "交易对上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tickerdock.binanceDown",
        "title": "交易对下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tickerdock.viewBinanceHistory",
        "title": "查看详情",
        "icon": "$(graph)"
      },
      {
        "command": "tickerdock.refreshForex",
        "title": "刷新外汇",
        "icon": "$(refresh)"
      },
      {
        "command": "tickerdock.refreshNews",
        "title": "刷新快讯",
        "icon": "$(refresh)"
      },
      {
        "command": "tickerdock.showNewsOutput",
        "title": "显示快讯输出",
        "icon": "$(output)"
      },
      {
        "command": "tickerdock.toggleNewsOutput",
        "title": "切换快讯输出",
        "icon": "$(radio-tower)"
      },
      {
        "command": "tickerdock.openFlashNews",
        "title": "打开快讯"
      },
      {
        "command": "tickerdock.openLeekCenter",
        "title": "打开韭菜中心",
        "icon": "$(home)"
      },
      {
        "command": "tickerdock.openStockConnectFlow",
        "title": "沪深港通资金流向",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "tickerdock.openMainCapitalFlow",
        "title": "主力资金流向",
        "icon": "$(pulse)"
      },
      {
        "command": "tickerdock.viewMarketSentiment",
        "title": "牛熊风向标",
        "icon": "$(dashboard)"
      },
      {
        "command": "tickerdock.manageSectors",
        "title": "管理板块",
        "icon": "$(edit)"
      },
      {
        "command": "tickerdock.openSector",
        "title": "打开板块详情"
      },
      {
        "command": "tickerdock.configureAi",
        "title": "配置AI",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tickerdock.openSettings",
        "title": "打开扩展设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tickerdock.openPersonalization",
        "title": "打开个性化设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tickerdock.configureAiHistoryRange",
        "title": "配置AI股票历史范围",
        "icon": "$(history)"
      },
      {
        "command": "tickerdock.deleteAiKey",
        "title": "删除AI密钥"
      },
      {
        "command": "tickerdock.askAi",
        "title": "询问AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "tickerdock.showAiOutput",
        "title": "显示AI研究输出",
        "icon": "$(output)"
      },
      {
        "command": "tickerdock.clearAiOutput",
        "title": "清空AI研究输出",
        "icon": "$(clear-all)"
      },
      {
        "command": "tickerdock.toggleMarketHours",
