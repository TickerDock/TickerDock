          "type": "boolean",
          "default": true,
          "description": "启用股票阈值提醒"
        },
        "stock-fund.binance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "BTC_USDT",
            "ETH_USDT"
          ]
        },
        "stock-fund.binanceSortMode": {
          "type": "string",
          "enum": [
            "original",
            "ascending",
            "descending"
          ],
          "default": "original",
          "description": "币安24小时涨跌排序方式"
        },
