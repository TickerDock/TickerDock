        "icon": "$(clock)"
      },
      {
        "command": "tickerdock.analyzeStock",
        "title": "AI 分析股票",
        "icon": "$(sparkle)"
      },
      {
        "command": "tickerdock.exportSettings",
        "title": "导出设置",
        "icon": "$(export)"
      },
      {
        "command": "tickerdock.importSettings",
        "title": "导入设置",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tickerdock.viewStockHistoryByCode",
        "title": "查看状态栏股票K线"
      },
      {
        "command": "tickerdock.togglePortfolioStatusBar",
        "title": "切换收益状态栏"
      },
      {
        "command": "tickerdock.toggleAllStatusBars",
        "title": "切换全部状态栏"
      },
      {
        "command": "tickerdock.toggleStockPortfolioStatusBar",
        "title": "切换股票收益状态栏"
      },
      {
        "command": "tickerdock.toggleFundPortfolioStatusBar",
        "title": "切换基金收益状态栏"
      },
      {
        "command": "tickerdock.toggleMarketStatusBar",
        "title": "切换行情状态栏"
      },
      {
        "command": "tickerdock.toggleStatusBarIcons",
        "title": "切换状态栏图标"
      },
      {
        "command": "tickerdock.configureStatusBarStocks",
        "title": "配置状态栏股票",
        "icon": "$(layout-statusbar)"
      },
      {
        "command": "tickerdock.addStockToStatusBar",
        "title": "添加到状态栏"
      },
      {
        "command": "tickerdock.removeStockFromStatusBar",
        "title": "从状态栏移除"
      },
      {
        "command": "tickerdock.addStockGroup",
        "title": "添加股票分组",
        "icon": "$(new-folder)"
      },
      {
        "command": "tickerdock.renameStockGroup",
        "title": "重命名股票分组"
      },
      {
        "command": "tickerdock.removeStockGroup",
        "title": "删除股票分组"
      },
      {
        "command": "tickerdock.addStock",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "tickerdock.deleteStock",
        "title": "删除股票"
      },
      {
        "command": "tickerdock.stockTop",
        "title": "置顶股票",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "tickerdock.stockUp",
        "title": "股票上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tickerdock.stockDown",
        "title": "股票下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tickerdock.setStockPosition",
        "title": "设置股票持仓",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "tickerdock.addStockReminder",
        "title": "添加股票提醒",
        "icon": "$(bell)"
      },
      {
        "command": "tickerdock.removeStockReminders",
        "title": "移除股票提醒"
      },
      {
        "command": "tickerdock.addFundGroup",
        "title": "添加基金分组",
        "icon": "$(new-folder)"
      },
      {
        "command": "tickerdock.renameFundGroup",
        "title": "重命名基金分组"
      },
      {
        "command": "tickerdock.removeFundGroup",
        "title": "删除基金分组"
      },
      {
        "command": "tickerdock.addFund",
        "title": "添加基金",
        "icon": "$(add)"
      },
      {
        "command": "tickerdock.deleteFund",
        "title": "删除基金"
      },
      {
        "command": "tickerdock.fundTop",
        "title": "置顶基金",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "tickerdock.fundUp",
        "title": "基金上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tickerdock.fundDown",
        "title": "基金下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tickerdock.setFundPosition",
        "title": "设置基金持仓",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tickerdock.refreshStock",
          "when": "view == tickerdock.stock",
          "group": "navigation"
        },
        {
          "command": "tickerdock.openLeekCenter",
          "when": "view == tickerdock.stock",
          "group": "navigation"
        },
        {
          "command": "tickerdock.viewMarketSentiment",
          "when": "view == tickerdock.stock",
          "group": "navigation"
        },
        {
          "command": "tickerdock.addStockGroup",
          "when": "view == tickerdock.stock",
          "group": "navigation"
        },
        {
          "command": "tickerdock.sortStock",
          "when": "view == tickerdock.stock",
          "group": "navigation"
        },
        {
          "command": "tickerdock.manageStockPositions",
          "when": "view == tickerdock.stock",
          "group": "navigation"
        },
        {
          "command": "tickerdock.refreshFund",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.addFundGroup",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.sortFund",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.viewFundRanking",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.viewFundComparison",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.viewFundOverview",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.manageFundPositions",
          "when": "view == tickerdock.fund",
          "group": "navigation"
        },
        {
          "command": "tickerdock.refreshBinance",
          "when": "view == tickerdock.binance",
          "group": "navigation"
        },
        {
          "command": "tickerdock.addBinancePair",
          "when": "view == tickerdock.binance",
          "group": "navigation"
        },
        {
          "command": "tickerdock.sortBinance",
          "when": "view == tickerdock.binance",
          "group": "navigation"
        },
        {
          "command": "tickerdock.refreshForex",
          "when": "view == tickerdock.forex",
