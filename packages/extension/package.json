            "arrow",
            "arrow1",
            "food1",
            "food2",
            "food3",
            "iconfood",
            "none"
          ],
          "default": "arrow",
          "description": "行情标签使用的涨跌图标样式"
        },
        "tickerdock.useCustomStatusBarColors": {
          "type": "boolean",
          "default": false,
          "description": "对状态栏项目应用自定义涨跌颜色"
        },
        "tickerdock.riseColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#e05252",
          "description": "行情上涨和持仓盈利时的状态栏颜色"
        },
        "tickerdock.fallColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#3fa66b",
          "description": "行情下跌和持仓亏损时的状态栏颜色"
        },
        "tickerdock.stockSortMode": {
          "type": "string",
          "enum": [
            "original",
            "ascending",
            "descending"
          ],
          "default": "original",
          "description": "股票涨跌排序方式"
        },
        "tickerdock.fundSortMode": {
          "type": "string",
          "enum": [
            "original",
            "ascending",
            "descending",
            "amount-ascending",
            "amount-descending"
          ],
          "default": "original",
          "description": "基金涨跌或持仓市值排序方式"
        },
        "tickerdock.stockPrice": {
          "type": "object",
          "default": {},
          "description": "由扩展管理的股票持仓数据"
        },
        "tickerdock.fundAmount": {
          "type": "object",
          "default": {},
          "description": "由扩展管理的基金持仓数据"
        },
        "tickerdock.showPortfolio": {
          "type": "boolean",
          "default": true,
