        },
        {
          "command": "tickerdock.removeStockFromStatusBar",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
          "group": "1_statusbar"
        },
        {
          "command": "tickerdock.deleteStock",
          "when": "view == tickerdock.stock && (viewItem == stockQuote || viewItem == stockPositionQuote)",
